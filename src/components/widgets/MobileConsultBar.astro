---
/**
 * スマホ表示で画面下部に固定する「相談はこちら」ボタン（全ページ共通）。
 * お問い合わせページ自体では表示しない。
 */
import { Icon } from 'astro-icon/components';

const isContactPage = Astro.url.pathname.replace(/\/$/, '') === '/contact';
---

{
  !isContactPage && (
    <>
      <div class="md:hidden h-20" aria-hidden="true" />
      <div class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-white/95 dark:bg-gray-900/95 backdrop-blur border-t border-bond-border px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
        <a
          href="/contact"
          class="btn-primary flex w-full items-center justify-center gap-2 py-3 text-base"
        >
          <Icon name="tabler:message-circle" class="w-5 h-5" />
          相談はこちら（初回相談は無料）
        </a>
      </div>
    </>
  )
}
